# =============================================================================
.pytest_cache/
.coverage
build/
dist/

# =============================================================================
# Data / weights / logs / outputs — sensitive or too large for GitHub.
# Rules are ANCHORED (leading slash) so they never match the source-code
# package dinov2/data/ — only the real data/weights/output directories.
# =============================================================================
*.npy
*.pth
*.pt
/linear_prober/data/
/linear_prober/outputs/
tmp/

# =============================================================================
# Editor / OS cruft
# =============================================================================
.DS_Store
*.swp
*.swo
*~
.idea/
.vscode/
