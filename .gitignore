# =============================================================================
*.npy
*.pth
*.pt
/linear_prober/data/
/linear_prober/outputs/
/3DINO_adapted/data_hcp/
/3DINO_adapted/datalists/
/3DINO_adapted/weights/
/3DINO_adapted/logs/
/3DINO_adapted/logs_cingulate/
/3DINO_adapted/outputs/
tmp/

